# ── Database ───────────────────────────────────────────────
# Owner/admin connection: used ONLY by migrations and seed (bypasses RLS).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/spot
# Application connection: non-owner role, every RLS policy applies.
# The migration script creates this role with the password given here.
DATABASE_URL=postgres://spot_app:spot_app_dev_password@localhost:5432/spot

# ── App ────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Local directory for uploaded images (served via /api/files/*)
STORAGE_DIR=./storage
# Protects POST /api/cron/tick (reminders, post-event prompts, scheduled campaigns)
CRON_SECRET=change-me

# ── Maps (optional) ────────────────────────────────────────
# Any XYZ raster tile server. Default: OpenStreetMap (respect its usage policy).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Not yet integrated (placeholders, see README "Integrations") ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
